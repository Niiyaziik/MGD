{
    "name": "mgd/mgd",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "migrate": "php -r \"require __DIR__ . '/bootstrap.php';\"",
        "db:fresh": "php database/fresh.php",
        "test": [
            "vendor/bin/phpunit",
            "@php -r \"$t=file_get_contents('coverage-report/coverage-summary.txt');if(preg_match('/Lines:[^\\n]+/',$t,$m)){echo trim($m[0]).PHP_EOL;}\""
        ],
        "test:unit": [
            "vendor/bin/phpunit --testsuite \"Unit tests\" --no-coverage"
        ],
        "test:integration": [
            "vendor/bin/phpunit --testsuite \"Integration tests\" --no-coverage"
        ],
        "test:functional": [
            "vendor/bin/phpunit --testsuite \"Functional tests\" --no-coverage"
        ]
    },
    "authors": [
        {
            "name": "Niiyaziik",
            "email": "144729110+niiyaziik@users.noreply.github.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "phpoffice/phpspreadsheet": "^5.3",
        "mpdf/mpdf": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "12"
    }
}
